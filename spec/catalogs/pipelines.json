{
  "schema_version": 1,
  "pipelines": [
    {
      "id": "fast-dictation",
      "name": "Fast Dictation",
      "status": "linux-1.0-default",
      "trigger": "toggle or hold",
      "privacy": "local-only",
      "stages": [
        "audio.capture",
        "audio.normalize",
        "audio.denoise",
        "speech.vad",
        "speech.endpoint",
        "speech.asr",
        "text.punctuation",
        "text.itn",
        "text.semantic-guard",
        "delivery.direct|delivery.clipboard|delivery.inbox"
      ]
    },
    {
      "id": "clean-mic",
      "name": "Clean Mic",
      "status": "optional",
      "trigger": "user binding",
      "privacy": "local-only",
