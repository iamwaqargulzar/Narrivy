{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://narrivy.invalid/schema/model-manifest-v1.json",
  "title":"Narrivy Model Manifest v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","id","revision","display_name","source","engine","format","tasks","languages","files","devices","license"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._/-]{1,127}$"},
    "revision":{"type":"string","minLength":1,"maxLength":200},
    "display_name":{"type":"string","minLength":1,"maxLength":120},
    "source":{"type":"object","additionalProperties":false,"required":["provider","locator","immutable_revision"],"properties":{"provider":{"enum":["huggingface","openvino","project","vendor","other"]},"locator":{"type":"string","minLength":1,"maxLength":500},"immutable_revision":{"type":"string","minLength":1,"maxLength":200},"publisher":{"type":"string","maxLength":200}}},
    "engine":{"type":"object","additionalProperties":false,"required":["id","min_version"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9._-]+$"},"min_version":{"type":"string","minLength":1},"max_version":{"type":["string","null"]}}},
    "format":{"type":"object","additionalProperties":false,"required":["family","precision"],"properties":{"family":{"type":"string","minLength":1},"precision":{"type":"string","minLength":1},"conversion_recipe":{"type":["string","null"]}}},
    "tasks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["transcribe","translate","refine","chat"]}},
    "languages":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":35}},
    "files":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","size_bytes"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"size_bytes":{"type":"integer","minimum":1},"optional_signature":{"type":["string","null"]}}}},
    "devices":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["CPU","GPU","NPU"]}},
    "memory":{"type":"object","additionalProperties":false,"properties":{"ram_estimate_bytes":{"type":"integer","minimum":0},"accelerator_estimate_bytes":{"type":"integer","minimum":0}}},
    "runtime_constraints":{"type":"object","additionalProperties":false,"properties":{"os":{"type":"array","uniqueItems":true,"items":{"enum":["linux","windows","macos"]}},"architectures":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"notes":{"type":"string","maxLength":1000}}},
    "license":{"type":"object","additionalProperties":false,"required":["spdx_or_name","source","redistribution"],"properties":{"spdx_or_name":{"type":"string","minLength":1,"maxLength":120},"source":{"type":"string","minLength":1,"maxLength":500},"redistribution":{"enum":["allowed","not_allowed","unknown"]},"notice":{"type":["string","null"],"maxLength":2000}}}
  }
}
