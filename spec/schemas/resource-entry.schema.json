{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrivy.local/schema/resource-entry-v1.json",
  "title": "Narrivy Resource Registry Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "artifact_class",
    "version",
    "license",
    "sources",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,159}$"
    },
    "artifact_class": {
      "enum": [
        "module",
        "runtime",
        "model",
        "pipeline"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "revision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "redistributable"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "redistributable": {
          "type": "boolean"
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "uri",
          "priority"
        ],
        "properties": {
          "kind": {
            "enum": [
              "upstream",
              "narrivy_mirror",
              "provider_gated",
              "custom"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "trust": {
      "enum": [
        "builtin",
        "narrivy_verified",
        "upstream_signed",
        "community",
        "local_developer"
      ]
    },
    "$schema": {
      "const": "https://narrivy.local/schema/resource-entry-v1.json"
    }
  }
}
