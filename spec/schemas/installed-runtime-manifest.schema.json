{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrivy.invalid/schema/installed-runtime-manifest-v1.json",
  "title": "Narrivy Installed Runtime Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "worker"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runtime_id": {
      "const": "transcribe.cpp"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      }
    }
  }
}
