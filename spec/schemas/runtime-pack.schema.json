{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://narrivy.local/schema/runtime-pack-v1.json",
  "title":"Narrivy Runtime Pack Manifest v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","version","api","platform","arch","device_classes","runtime","artifacts","capabilities","license","self_test"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},
    "version":{"type":"string","minLength":1,"maxLength":64},
    "api":{"type":"object","additionalProperties":false,"required":["major"],"properties":{"major":{"type":"integer","minimum":1},"min_minor":{"type":"integer","minimum":0}}},
    "platform":{"enum":["linux","windows","macos"]},
    "arch":{"enum":["x86_64","aarch64"]},
    "device_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["npu","dgpu","igpu","cpu"]}},
    "runtime":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"type":"string","minLength":1},"vendor":{"type":["string","null"]},"version":{"type":"string","minLength":1},"driver_constraints":{"type":"array","items":{"type":"string","minLength":1}},"kernel_constraints":{"type":"array","items":{"type":"string","minLength":1}}}},
    "artifacts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","size_bytes"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size_bytes":{"type":"integer","minimum":1}}}},
    "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "model_formats":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":64}},
    "license":{"type":"object","additionalProperties":false,"required":["spdx","redistributable"],"properties":{"spdx":{"type":"string","minLength":1},"redistributable":{"type":"boolean"},"notice":{"type":["string","null"]}}},
    "provenance":{"type":["string","null"]},
    "signature":{"type":["string","null"]},
    "self_test":{"type":"object","additionalProperties":false,"required":["command","fixture_id"],"properties":{"command":{"type":"string","minLength":1},"fixture_id":{"type":"string","minLength":1}}}
  }
}
