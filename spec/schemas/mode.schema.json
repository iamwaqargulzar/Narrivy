{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://narrivy.invalid/schema/mode-v1.json",
  "title":"Narrivy Mode v1","type":"object","additionalProperties":false,
  "required":["schema_version","id","name","pipeline"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,79}$"},
    "name":{"type":"string","minLength":1,"maxLength":80},
    "description":{"type":"string","maxLength":500},
    "pipeline":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/stage"}},
    "output":{"type":"object","additionalProperties":false,"properties":{"preserve_line_breaks":{"type":"boolean"},"trim_outer_whitespace":{"type":"boolean"}}}
  },
  "$defs":{
    "stage":{"type":"object","additionalProperties":false,"required":["id","processor","execution","data_requirements"],"properties":{
      "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
      "processor":{"type":"string","pattern":"^[a-z0-9][a-z0-9._/-]{0,127}$"},
      "enabled":{"type":"boolean","default":true},
      "optional":{"type":"boolean","default":false},
      "execution":{"enum":["local_required","local_preferred","remote_allowed"]},
      "data_requirements":{"type":"array","uniqueItems":true,"items":{"enum":["transcript","selected_text","surrounding_text","app_identity","window_title","clipboard","project_terms","dictionary","language"]}},
      "config":{"type":"object","maxProperties":64}
    }}
  }
}
