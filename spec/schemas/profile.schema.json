{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://narrivy.invalid/schema/profile-v1.json",
  "title":"Narrivy App Profile v1","type":"object","additionalProperties":false,
  "required":["schema_version","id","name","enabled","priority","match","mode_id"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,79}$"},
    "name":{"type":"string","minLength":1,"maxLength":80},
    "enabled":{"type":"boolean"},
    "priority":{"type":"integer","minimum":-1000,"maximum":1000},
    "mode_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,79}$"},
    "match":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["field","operator","value"],"properties":{"field":{"enum":["app_id","executable","window_title"]},"operator":{"enum":["eq","contains","prefix","regex"]},"value":{"type":"string","minLength":1,"maxLength":256}}}},
    "overrides":{"type":"object","additionalProperties":false,"properties":{"microphone_id":{"type":"string","maxLength":200},"audio_policy":{"enum":["leave","duck","pause","mute","smart"]},"delivery_preference":{"type":"string","maxLength":80}}}
  }
}
