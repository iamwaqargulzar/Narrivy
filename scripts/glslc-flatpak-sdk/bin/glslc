#!/bin/sh
# Runs the newest glslc from an installed Flatpak org.freedesktop.Sdk (25.08 or
# later) with that SDK's own loader and libraries. build_release_candidate.sh
# uses it, as VULKAN_SDK=scripts/glslc-flatpak-sdk, when the system glslc is
# too old to build ggml-vulkan's integer dot-product shaders.
set -eu
sdk=""
for dir in "$HOME/.local/share/flatpak" /var/lib/flatpak; do
    for files in "$dir"/runtime/org.freedesktop.Sdk/x86_64/*/active/files; do
        [ -x "$files/bin/glslc" ] || continue
        # Branches are YY.MM, so the last one in glob order is the newest.
        sdk="$files"
    done
    [ -n "$sdk" ] && break
done
[ -n "$sdk" ] || { echo "glslc-flatpak-sdk: no org.freedesktop.Sdk with glslc is installed" >&2; exit 127; }
lib="$sdk/lib/x86_64-linux-gnu"
exec "$lib/ld-linux-x86-64.so.2" --library-path "$lib" "$sdk/bin/glslc" "$@"
