{
  "manifest_version": 3,
  "name": "Narrivy Writing",
  "short_name": "Narrivy",
  "version": "0.1.1",
  "description": "Private grammar, spelling and AI rewriting that runs on your own computer through Narrivy. Nothing you type leaves your device.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Narrivy Writing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "content.js"
      ],
      "css": [
        "highlights.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-actions": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open Narrivy's writing actions for the selection or the field"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
