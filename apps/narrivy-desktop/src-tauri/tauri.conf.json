{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Narrivy",
  "version": "1.0.0-rc.13",
  "identifier": "app.narrivy.shell",
  "build": {
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Narrivy",
        "url": "index.html",
        "width": 1100.0,
        "height": 720.0,
        "minWidth": 940.0,
        "minHeight": 600.0,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Narrivy Overlay",
        "url": "index.html",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "transparent": true,
        "width": 500.0,
        "height": 72.0
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": false
  }
}
